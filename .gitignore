# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Data (large files, git-ignored)
data/
*.zip
*.tar.gz
# ...except small, deliberate source-code bundles committed for Kaggle
# handoff (see notebooks/ebnerd_part0_kaggle_investigation.py's docstring
# for the pattern) — these are build artifacts of tracked src/, not raw
# data, and need to be committed so the engineer can upload them as-is.
!notebooks/*.zip

# Experiments (results)
experiments/

# Submissions (generated prediction/truth files, large + regenerable) —
# but leaderboard screenshots are a Q7 deliverable and must stay trackable
# (they're small, ~260-700KB each, not the large regenerable files this
# rule exists for).
submissions/*
!submissions/*/
submissions/*/*
!submissions/*/*.png

# Model checkpoints
*.pt
*.pth
*.ckpt
*.bin

# OS
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Environment
.env
.env.local
