# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Data (large files, git-ignored)
data/
*.zip
*.tar.gz
# ...except small, deliberate source-code bundles committed for Kaggle
# handoff (see notebooks/ebnerd_part0_kaggle_investigation.py's docstring
# for the pattern) — these are build artifacts of tracked src/, not raw
# data, and need to be committed so the engineer can upload them as-is.
!notebooks/*.zip

# Experiments (results)
experiments/

# Submissions (generated prediction/truth files, large + regenerable) —
# but leaderboard screenshots are a Q7 deliverable and must stay trackable
# (they're small, ~260-700KB each, not the large regenerable files this
# rule exists for).
submissions/*
!submissions/*/
submissions/*/*
!submissions/*/*.png

# Model checkpoints
*.pt
*.pth
*.ckpt
*.bin

# OS
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Environment
.env
.env.local

# --- Performance benchmarking (ADR-014) ---------------------------------
# SLURM writes job logs (%x_%j.out / .err) into the directory the job was
# submitted from. Those are transient and would accumulate in the repo root on
# every run. The deliberately FETCHED Ada logs under
# benchmarks/results/ada/ are deliberately NOT matched by these rules — they are
# the primary record behind ADR-014's job ids and are kept as evidence.
/*.out
/*.err
/benchmarks/*.out
/benchmarks/*.err

# Snapshot JSONs are written by the pre-commit hook on EVERY performance-
# relevant commit, so they grow without bound. PERFORMANCE_LOG.md already
# carries the human-readable before/after record, which is the deliverable.
# The full-scale profile/ablation JSONs in benchmarks/results/ are NOT ignored:
# they are small (164KB total), written rarely, and are the evidence ADR-014
# cites directly — the analogue of experiments/results.json, not of the model
# blobs that got experiments/ ignored wholesale.
benchmarks/results/snapshots/

# Large numeric/model artifacts, wherever they land. None are tracked today;
# these are a guard for a fresh remote, where an accidental large commit is
# permanent in history even after deletion.
*.npy
*.parquet
*.pkl
*.joblib
*.h5
*.onnx
*.safetensors
